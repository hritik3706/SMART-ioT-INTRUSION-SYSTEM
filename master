  if (Blynk.connected()) {
    Blynk.virtualWrite(V0, 1);
    Blynk.logEvent("intrusion_detected", "⚠️ Intrusion Detected! Check NOW!");
  }

  bot.sendMessage(CHAT_ID,
    "🚨 *INTRUSION ALERT!* 🚨\n"
    "━━━━━━━━━━━━━━━━━━━━\n"
    "⚡ Laser beam BROKEN!\n"
    "🔊 Military Alert SOUNDING!\n"
    "📷 Capturing photo now...\n"
    "━━━━━━━━━━━━━━━━━━━━\n"
    "_Take immediate action!_",
    "Markdown");

  delay(PHOTO_DELAY);      // buzzer keeps going during this
  captureAndSendPhoto();   // buzzer keeps going during this too
}

// ══════════════════════════════════════════════════════════
//   CAPTURE & SEND PHOTO → TELEGRAM via IP Webcam
// ══════════════════════════════════════════════════════════
void captureAndSendPhoto() {
  if (photoSent) return;

  Serial.println("📷 Fetching photo from IP Webcam...");

  WiFiClient httpClient;
  HTTPClient http;

  http.begin(httpClient, SNAPSHOT_URL);
  http.setTimeout(10000);
  http.addHeader("User-Agent", "ESP8266-Security/7.0");
  int httpCode = http.GET();

  Serial.printf("   HTTP Code: %d\n", httpCode);

  if (httpCode == HTTP_CODE_OK) {
    imgSize = http.getSize();
    Serial.printf("   Size: %d bytes\n", imgSize);

    int bufSize = (imgSize == -1) ? 80000 : imgSize;
    imgBuffer   = (uint8_t*)malloc(bufSize);

    if (imgBuffer != nullptr) {
      WiFiClient*   stream   = http.getStreamPtr();
      int           received = 0;
      unsigned long t0       = millis();

      while (received < bufSize && millis() - t0 < 8000) {
        if (stream->available()) {
          int chunk = stream->readBytes(imgBuffer + received,
                        min((int)stream->available(), bufSize - received));
          received += chunk;
        }
        if (received >= 2 &&
            imgBuffer[received - 2] == 0xFF &&
            imgBuffer[received - 1] == 0xD9) {
          Serial.println("   JPEG EOF ✅");
          break;
        }
        yield();
      }

      Serial.printf("   Received: %d bytes\n", received);

      if (received >= 5000) {
        imgReadPos = 0;
        imgSize    = received;

        String result = bot.sendPhotoByBinary(
          CHAT_ID, "image/jpeg", imgSize,
          isMoreDataAvailable, getNextByte, getNextBuffer, nullptr
        );

        if (result.length() > 0) {
          Serial.println("✅ Photo sent!");
          bot.sendMessage(CHAT_ID,
            "📷 *Intruder captured above!*\n"
            "🔒 Take action immediately!\n"
            "🌐 Live: http://10.159.6.17:8080",
            "Markdown");
          photoSent = true;
        } else {
          Serial.println("❌ Telegram rejected photo");
          bot.sendMessage(CHAT_ID,
            "⚠️ Photo upload failed.\n📱 Live: http://10.159.6.17:8080", "");
        }
      } else {
        bot.sendMessage(CHAT_ID,
          "⚠️ Incomplete photo.\n📱 Live: http://10.159.6.17:8080", "");
      }

      free(imgBuffer);
      imgBuffer = nullptr;

    } else {
      bot.sendMessage(CHAT_ID, "⚠️ Low RAM.\n📱 Live: http://10.159.6.17:8080", "");
    }

  } else {
    bot.sendMessage(CHAT_ID,
      "🚨 *INTRUSION!*\n⚠️ Camera error HTTP " + String(httpCode) +
      "\n• Open IP Webcam → Start Server", "Markdown");
  }

  http.end();
}

// ══════════════════════════════════════════════════════════
//   STOP ALARM
// ══════════════════════════════════════════════════════════
void stopAlarm() {
  stopBuzzerTimer();
  alarmActive = false;
  Serial.println("🔕 Alarm Stopped.\n");

  if (Blynk.connected()) Blynk.virtualWrite(V0, 0);

  bot.sendMessage(CHAT_ID,
    "✅ *Alarm Stopped*\n"
    "━━━━━━━━━━━━━━━━━━━━\n"
    "🟢 Area clear\n"
    "🔍 System resumed monitoring\n"
    "━━━━━━━━━━━━━━━━━━━━",
    "Markdown");
}

// ══════════════════════════════════════════════════════════
//   BLYNK AUTO-RECONNECT
// ══════════════════════════════════════════════════════════
void maintainBlynk() {
  if (!Blynk.connected() && WiFi.status() == WL_CONNECTED) {
    if (millis() - lastReconnect >= RECONNECT_DELAY) {
      lastReconnect = millis();
      Serial.println("🔄 Retrying Blynk...");
      Blynk.connect(3000);
      if (Blynk.connected()) Serial.println("✅ Blynk Reconnected!");
    }
  }
}

// ══════════════════════════════════════════════════════════
//   SEND SENSOR DATA TO BLYNK
// ══════════════════════════════════════════════════════════
void sendSensorData() {
  if (!Blynk.connected()) return;
  Blynk.virtualWrite(V1, digitalRead(LDR_PIN));
  Blynk.virtualWrite(V2, digitalRead(PIR_PIN));
}
