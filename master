// ══════════════════════════════════════════════════════════
//   MILITARY ALERT BUZZER — Hardware Timer Driven
//
//  Pattern (repeating, total ~1400ms per cycle):
//
//  ┌─────────────────────────────────────────────────────┐
//  │  BURST of 3 sharp pulses  →  long silence  → repeat │
//  │                                                     │
//  │  PULSE: ON 80ms  OFF 60ms  ×3  = 420ms             │
//  │  GAP:   silence  400ms                              │
//  │  Then: single long BOOM: ON 180ms  OFF 60ms         │
//  │  GAP:   silence  280ms                              │
//  │                                                     │
//  │  Sounds like:                                       │
//  │  BEEP-BEEP-BEEP ··· BOOOOM ··· BEEP-BEEP-BEEP ...  │
//  │  Urgent, rhythmic, impossible to ignore             │
//  └─────────────────────────────────────────────────────┘
//
//  Timer fires every 20ms. Each tick = 1 step in sequence.
//  Sequence array holds ON/OFF durations in 20ms units.
// ══════════════════════════════════════════════════════════
#include <osapi.h>
#include <os_type.h>

// Sequence: {pin_state, duration_in_ticks}
// Each tick = 20ms
// ON=1, OFF=0
struct BuzzerStep {
  uint8_t       pinState;   // HIGH or LOW
  uint8_t       ticks;      // how many 20ms ticks to hold
};

// Military alert sequence (one full cycle ~1400ms)
//   3× sharp pulses:  80ms ON, 60ms OFF each
//   400ms silence
//   1× boom pulse:    180ms ON, 60ms OFF
//   280ms silence
static const BuzzerStep milAlert[] = {
  {HIGH, 4},   // BEEP  ON  80ms
  {LOW,  3},   // BEEP  OFF 60ms
  {HIGH, 4},   // BEEP  ON  80ms
  {LOW,  3},   // BEEP  OFF 60ms
  {HIGH, 4},   // BEEP  ON  80ms
  {LOW,  20},  // silence  400ms
  {HIGH, 9},   // BOOM  ON  180ms
  {LOW,  3},   // BOOM  OFF 60ms
  {LOW,  14},  // silence  280ms
};
static const int milAlertLen = sizeof(milAlert) / sizeof(BuzzerStep);

static os_timer_t buzzerTimer;
volatile bool     buzzerRunning = false;

static int  seqIdx    = 0;   // current step index
static int  ticksLeft = 0;   // ticks remaining in current step

void ICACHE_RAM_ATTR buzzerISR(void* arg) {
  if (!buzzerRunning) {
    digitalWrite(BUZZER_PIN, LOW);
    return;
  }

  if (ticksLeft > 0) {
    ticksLeft--;
    return;
  }

  // Move to next step
  seqIdx = (seqIdx + 1) % milAlertLen;
  digitalWrite(BUZZER_PIN, milAlert[seqIdx].pinState ? HIGH : LOW);
  ticksLeft = milAlert[seqIdx].ticks - 1;
}

void startBuzzer() {
  seqIdx       = 0;
  ticksLeft    = milAlert[0].ticks - 1;
  buzzerRunning = true;
  digitalWrite(BUZZER_PIN, milAlert[0].pinState ? HIGH : LOW);
  os_timer_setfn(&buzzerTimer, buzzerISR, nullptr);
  os_timer_arm(&buzzerTimer, 20, true);   // fires every 20ms
}

void stopBuzzerTimer() {
  buzzerRunning = false;
  os_timer_disarm(&buzzerTimer);
  digitalWrite(BUZZER_PIN, LOW);
}

// ══════════════════════════════════════════════════════════
//   GLOBAL IMAGE BUFFER
// ══════════════════════════════════════════════════════════
uint8_t* imgBuffer  = nullptr;
int      imgSize    = 0;
int      imgReadPos = 0;

bool  isMoreDataAvailable() { return imgReadPos < imgSize; }
byte  getNextByte()         { return imgBuffer[imgReadPos++]; }
byte* getNextBuffer()       {
  if (imgReadPos >= imgSize) return nullptr;
  byte* ptr  = imgBuffer + imgReadPos;
  imgReadPos = imgSize;
  return ptr;
}

