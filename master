// ══════════════════════════════════════════════════════════
//   MAIN LOOP
// ══════════════════════════════════════════════════════════
void loop() {
  maintainBlynk();
  if (Blynk.connected()) Blynk.run();
  timer.run();

  bool laserBroken = readLDR();

  static unsigned long lastPrint = 0;
  if (millis() - lastPrint >= 500) {
    lastPrint = millis();
    Serial.printf("[SENSOR] LDR_raw=%d | Stable=%d | Confirmed=%d | PIR=%d | Alarm=%d | Blynk=%s\n",
      digitalRead(LDR_PIN), ldrStable, ldrConfirmed,
      digitalRead(PIR_PIN), alarmActive,
      Blynk.connected() ? "OK" : "OFFLINE");
  }

  if (laserBroken && !alarmActive)                          triggerAlarm();
  if (alarmActive && millis() - buzzerStart >= BUZZER_TIME) stopAlarm();
}

// ══════════════════════════════════════════════════════════
//   HIGH-ACCURACY LDR READ — Two-layer filter
// ══════════════════════════════════════════════════════════
bool readLDR() {
  int raw = digitalRead(LDR_PIN);
  unsigned long now = millis();

  if (raw != lastLdrRaw) {
    lastLdrRaw    = raw;
    ldrChangeTime = now;
    ldrConfirming = false;
  }

  if ((now - ldrChangeTime) >= DEBOUNCE_MS) {
    bool newStable = (lastLdrRaw == HIGH);
    if (newStable != ldrStable) {
      ldrStable = newStable;
      if (ldrStable) {
        ldrConfirming   = true;
        ldrConfirmStart = now;
        ldrConfirmed    = false;
      } else {
        ldrConfirmed  = false;
        ldrConfirming = false;
      }
    }
  }

  if (ldrConfirming && ldrStable) {
    if ((now - ldrConfirmStart) >= LDR_CONFIRM_MS) {
      ldrConfirmed  = true;
      ldrConfirming = false;
    }
  }

  return ldrConfirmed;
}

// ══════════════════════════════════════════════════════════
//   TRIGGER ALARM
// ══════════════════════════════════════════════════════════
void triggerAlarm() {
